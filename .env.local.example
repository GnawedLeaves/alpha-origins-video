# Alpha Origins environment variables
# Copy to .env.local (`cp .env.local.example .env.local`) and fill in every value marked REQUIRED.
# .env.local is gitignored. Never commit real keys.
# Restart `npm run dev` after changing this file.

# ---------------------------------------------------------------------------
# Supabase (REQUIRED): database, auth, file storage
# Supabase dashboard -> your project -> Project Settings -> API
# ---------------------------------------------------------------------------

# REQUIRED. "Project URL", e.g. https://abcdefghijklm.supabase.co
NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url

# REQUIRED. "anon" / "publishable" key. Safe to expose to the browser (RLS protects the data).
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# REQUIRED. "service_role" / "secret" key. SERVER ONLY: it bypasses Row Level Security.
# Used only by the fal.ai webhook route. Never prefix with NEXT_PUBLIC_ or share it.
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ---------------------------------------------------------------------------
# fal.ai (REQUIRED): AI video generation
# https://fal.ai/dashboard/keys (needs billing credits on your fal account)
# ---------------------------------------------------------------------------

# REQUIRED. Format: key_id:key_secret
FAL_KEY=your-fal-key

# REQUIRED in production (when NEXT_PUBLIC_SITE_URL is a public URL). Signs the webhook
# callback URL so nobody else can post fake results. Any long random string works. Generate one:
#   openssl rand -hex 32
FAL_WEBHOOK_SECRET=your-random-webhook-secret

# ---------------------------------------------------------------------------
# Google Gemini (REQUIRED): AI caption writing. Free tier, no billing needed.
# https://aistudio.google.com/apikey -> "Create API key"
# ---------------------------------------------------------------------------

# REQUIRED.
GEMINI_API_KEY=your-gemini-api-key

# OPTIONAL. Model used for captions. Defaults to gemini-flash-latest (current free-tier Flash).
# GEMINI_MODEL=gemini-flash-latest

# OPTIONAL. Used automatically when the main model is overloaded or rate-limited.
# Defaults to gemini-flash-lite-latest (also free tier, separate quota).
# GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# ---------------------------------------------------------------------------
# App URL
# ---------------------------------------------------------------------------

# REQUIRED. http://localhost:3000 for local dev, your real domain in production.
# While it contains "localhost", the app polls fal.ai for results instead of using webhooks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
